# ==============================================================================
# 카카오톡 작업 시간 대시보드 환경 설정 파일 (.env)
# ==============================================================================

# Supabase 연동 정보 (Supabase 대시보드 > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# 카카오톡 PC 자동 수집 설정
KAKAO_CHAT_TITLE=기술 1팀
COLLECTOR_INTERVAL_SECONDS=600  # 10분 (600초)

# 로컬 백업 DB 경로 (Supabase 연결 불가 또는 로컬 캐시용)
LOCAL_DB_PATH=data/worklog.db
